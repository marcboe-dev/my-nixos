{
  "manifest_version": 3,
  "name": "YouTube-Tempo J/K",
  "version": "1.0",
  "description": "YouTube: J = Tempo -0.05, K = Tempo +0.05",
  "content_scripts": [{
    "matches": ["*://*.youtube.com/*", "*://youtube.com/*"],
    "js": ["speed.js"],
    "run_at": "document_start",
    "all_frames": true
  }]
}
