{
  "manifest_version": 3,
  "key": "",
  "name": "Tab-Navigation Alt+h/l",
  "version": "1.3",
  "description": "Alt+h = Tab links, Alt+l = Tab rechts",
  "background": { "service_worker": "background.js" },
  "commands": {
    "tab-left":  { "suggested_key": { "default": "Alt+H" }, "description": "Tab nach links" },
    "tab-right": { "suggested_key": { "default": "Alt+L" }, "description": "Tab nach rechts" }
  },
  "content_scripts": [{
    "matches": ["<all_urls>"],
    "js": ["keys.js"],
    "run_at": "document_start",
    "all_frames": true
  }]
}
