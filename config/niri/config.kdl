// This config is in the KDL format: https://kdl.dev
// "/-" comments out the following node.
// Check the wiki for a full description of the configuration:
// https://niri-wm.github.io/niri/Configuration:-Introduction

// Input device configuration.
// Find the full list of options on the wiki:
// https://niri-wm.github.io/niri/Configuration:-Input

prefer-no-csd
spawn-at-startup "noctalia"

gestures {
    hot-corners {
        off
    }
}

input {
    keyboard {
        repeat-rate 35
        repeat-delay 200

        xkb {
            layout "at"
        }
        numlock
    }

    touchpad {
        tap
        natural-scroll
    }

    mouse {
    }

    trackpoint {
    }

    focus-follows-mouse max-scroll-amount="0%"
}

output "eDP-1" {
    scale 1.25
    transform "normal"
    position x=1280 y=0
}

output "Samsung Electric Company SAMSUNG 0x00000001" {
    scale 1.5
    position x=0 y=0
}

output "Lenovo Group Limited T24m-20 V908ZPP0" {
    mode "1920x1080@74.986"
    scale 1.25
    position x=2816 y=0
}

layout {
    gaps 0

    center-focused-column "never"

    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }

    default-column-width { proportion 1.0; }

    focus-ring {
        off
        width 1.5
        active-color "#7fc8ff"
        inactive-color "#505050"
    }

    // You can also add a border. It's similar to the focus ring, but always visible.
    border {
        width 1.5
        active-color "#7fc8ff"
        inactive-color "#505050"
        urgent-color "#9b0000"
    }

    shadow {
        softness 30
        spread 5
        offset x=0 y=5
        color "#0007"
    }

    struts {
    }
}

// Avoid writing screenshots to disk since they get piped into satty.
screenshot-path null

cursor {
    xcursor-theme "Adwaita"
    xcursor-size 24
}

hotkey-overlay {
    skip-at-startup
}

animations {
    off
}

// Alles mit app-id "dfr.floating.*" öffnet klein und schwebend
// (Thunar floating, Kitty floating).
window-rule {
    match app-id=r#"^dfr\.floating\."#
    open-floating true
    default-column-width { proportion 0.33; }
    default-window-height { proportion 0.5; }
}

// Kleinkram, der nicht getiled werden soll.
window-rule {
    match title=r#"^Picture.in.Picture$"#
    match app-id=r#"^mpv$"#
    match app-id=r#"^thunar$"# title=r#"^Rename "#
    open-floating true
}

window-rule {
    match app-id=r#"^com\.gabm\.satty$"#
    open-floating true
    min-width 730
    min-height 300
}

// Datei-Dialoge (Öffnen/Speichern) des GNOME-Portals schweben,
// sonst verschwinden sie hinter schwebenden Fenstern wie Obsidians Vault-Auswahl.
window-rule {
    match app-id=r#"^org\.gnome\.Nautilus$"#
    open-floating true
}

// ============================================================================
//  KEYBINDINGS
// ----------------------------------------------------------------------------
//  Grundregel – jeder Modifier ist eine Kategorie:
//
//    Mod + Taste              Fenster & Navigation
//    Mod + Shift + Taste      dieselbe Aktion als Variante
//                             (mitnehmen/verschieben, rückwärts, stärker)
//    Mod + Ctrl + Richtung    eine Ebene höher: Monitor (bzw. Workspace)
//    Mod + Alt + Buchstabe    NUR Apps starten/fokussieren
//    Mod + Alt + Shift + Bst. dieselbe App, schwebend
//    Mod + Ctrl + Buchstabe   System, Skripte, Toggles
//    Print (+ Shift/Ctrl)     Screenshots
//
//  Richtungstasten: HJKL / Pfeile (links/rechts = Spalten, hoch/runter = Fenster)
//                   U/I (Workspaces), 1–9 (Workspace direkt)
// ============================================================================

binds {

    // ------------------------------------------------------------------------
    //  LAUNCHER & HILFE
    // ------------------------------------------------------------------------
    Mod+Space       hotkey-overlay-title="Launcher: Apps (rofi)" { spawn-sh "pkill -x rofi || rofi -show drun"; }
    Mod+D           { spawn-sh "pkill -x rofi || rofi -show drun"; }   // Alias, alte Gewohnheit
        Mod+P           hotkey-overlay-title="Launcher: Projekte / tmux / Bookmarks" { spawn-sh "pkill -x rofi || pkill -x 'rofi-(launch|sessions|repos|bookmarks)' || rofi-launch"; }
    Mod+Shift+ssharp { show-hotkey-overlay; }                          // = Mod+?  (AT-Layout)


    // ------------------------------------------------------------------------
    //  APPS  —  Mod + Alt + Buchstabe   (Alt+Shift = schwebend)
    // ------------------------------------------------------------------------
    // Terminal (Sonderfall Return: Basis = Mod, Variante = Shift)
    Mod+Return       hotkey-overlay-title="Terminal" { spawn "kitty"; }
    Mod+Shift+Return hotkey-overlay-title="Terminal (schwebend)" { spawn "kitty" "--class" "dfr.floating.kitty"; }
    Mod+Ctrl+Return  hotkey-overlay-title="Terminal: ~/nixos-dotfiles" { spawn-sh "kitty --directory ~/nixos-dotfiles"; }

    // GUI-Apps
    Mod+Alt+B        hotkey-overlay-title="Browser: Brave" { spawn "dfr-launch-or-focus" "^brave-browser$" "brave"; }
    Mod+Alt+O        hotkey-overlay-title="Obsidian" { spawn "dfr-launch-or-focus" "obsidian$" "obsidian"; }
    Mod+Alt+F        hotkey-overlay-title="Dateien: Thunar" { spawn "thunar"; }
    Mod+Alt+Shift+F  hotkey-overlay-title="Dateien: Thunar (schwebend)" { spawn "thunar" "--name=dfr.floating.thunar"; }

    // TUIs (launch-or-focus mit eigener app-id dfr.kitty.<app>)
    Mod+Alt+N        hotkey-overlay-title="Editor: Neovim" { spawn "dfr-launch-or-focus-tui" "nvim"; }
    Mod+Alt+Y        hotkey-overlay-title="Dateien: yazi" { spawn "dfr-launch-or-focus-tui" "yazi"; }
    Mod+Alt+M        hotkey-overlay-title="Musik: rmpc" { spawn "dfr-launch-or-focus-tui" "rmpc"; }
    Mod+Alt+H        hotkey-overlay-title="System health: btop" { spawn "dfr-launch-or-focus-tui" "btop"; }


    // ------------------------------------------------------------------------
    //  SYSTEM & SKRIPTE  —  Mod + Ctrl + Buchstabe
    // ------------------------------------------------------------------------
    Mod+Ctrl+Q       hotkey-overlay-title="Bildschirm sperren" { spawn "noctalia" "msg" "session" "lock"; }
    Mod+Ctrl+Shift+Q hotkey-overlay-title="Sperren + Standby (Suspend)" { spawn "noctalia" "msg" "session" "lock-and-suspend"; }
    Mod+Ctrl+K       hotkey-overlay-title="Kochmodus: Bildschirm bleibt an (ein/aus)" { spawn "noctalia" "msg" "caffeine-toggle"; }
    Mod+Ctrl+B       hotkey-overlay-title="Noctalia Bar ein/aus" { spawn "noctalia" "msg" "bar-toggle"; }
    Mod+Ctrl+G       hotkey-overlay-title="Dotfiles: git pull" { spawn "dotfiles-sync"; }
    Mod+Ctrl+S       hotkey-overlay-title="Layout speichern (nirinit)" { spawn "nirinit-save"; }
    Mod+Ctrl+T       hotkey-overlay-title="TV: Bildwiederholrate wechseln" { spawn "tv-hz"; }
    Mod+Ctrl+P       hotkey-overlay-title="Monitore ausschalten" { power-off-monitors; }


    // niri beenden (mit Bestätigungsdialog)
    Mod+Shift+E      { quit; }
    Ctrl+Alt+Delete  { quit; }


    // ------------------------------------------------------------------------
    //  SCREENSHOTS  —  Print-Familie  (Mod+S = schnelle Region ohne Print-Taste)
    // ------------------------------------------------------------------------
    Mod+S            hotkey-overlay-title="Screenshot: Region" { spawn "dfr-screenshot" "region"; }
    Print            hotkey-overlay-title="Screenshot: Region" { spawn "dfr-screenshot" "region"; }
    Shift+Print      hotkey-overlay-title="Screenshot: Fenster" { spawn "dfr-screenshot" "window"; }
    Ctrl+Print       hotkey-overlay-title="Screenshot: Monitor (fokussiert)" { spawn "dfr-screenshot" "monitor-focused"; }
    Ctrl+Shift+Print hotkey-overlay-title="Screenshot: alle Monitore" { spawn "dfr-screenshot" "monitor-all"; }


    // ------------------------------------------------------------------------
    //  FENSTER — GRUNDAKTIONEN  (Mod = Basis, Shift = Variante)
    // ------------------------------------------------------------------------
    Mod+Q repeat=false { close-window; }
    Mod+O repeat=false { toggle-overview; }

    // Größe
    Mod+F            hotkey-overlay-title="Spalte maximieren" { maximize-column; }
    Mod+Shift+F      hotkey-overlay-title="Vollbild" { fullscreen-window; }
    Mod+Ctrl+F       hotkey-overlay-title="Spalte auf freien Platz ausdehnen" { expand-column-to-available-width; }
    Mod+M            { maximize-window-to-edges; }        // randlos maximieren

    // Breiten-/Höhen-Presets
    Mod+R            { switch-preset-column-width; }
    Mod+Shift+R      { switch-preset-column-width-back; }
    Mod+Ctrl+R       { reset-window-height; }
    Mod+Ctrl+Shift+R { switch-preset-window-height; }

    // Feinjustierung (Basis = Breite, Shift = Höhe)
    Mod+Minus        { set-column-width "-10%"; }
    Mod+Equal        { set-column-width "+10%"; }
    Mod+Shift+Minus  { set-window-height "-10%"; }
    Mod+Shift+Equal  { set-window-height "+10%"; }

    // Zentrieren
    Mod+C            { center-column; }
    Mod+Ctrl+C       { center-visible-columns; }

    // Floating / Tabs
    Mod+V            { toggle-window-floating; }
    Mod+Shift+V      { switch-focus-between-floating-and-tiling; }
    Mod+W            { toggle-column-tabbed-display; }

    // Fenster in/aus Spalte
    Mod+BracketLeft  { consume-or-expel-window-left; }
    Mod+BracketRight { consume-or-expel-window-right; }
    Mod+Comma        { consume-window-into-column; }
    Mod+Period       { expel-window-from-column; }


    // ------------------------------------------------------------------------
    //  FOKUS  —  Mod + Richtung
    // ------------------------------------------------------------------------
    Mod+H     { focus-column-left; }
    Mod+J     { focus-window-down; }
    Mod+K     { focus-window-up; }
    Mod+L     { focus-column-right; }
    Mod+Left  { focus-column-left; }
    Mod+Down  { focus-window-down; }
    Mod+Up    { focus-window-up; }
    Mod+Right { focus-column-right; }

    Mod+Home  { focus-column-first; }
    Mod+End   { focus-column-last; }


    // ------------------------------------------------------------------------
    //  VERSCHIEBEN  —  Mod + Shift + Richtung   ("Fenster mitnehmen")
    // ------------------------------------------------------------------------
    Mod+Shift+H     { move-column-left; }
    Mod+Shift+J     { move-window-down; }
    Mod+Shift+K     { move-window-up; }
    Mod+Shift+L     { move-column-right; }
    Mod+Shift+Left  { move-column-left; }
    Mod+Shift+Down  { move-window-down; }
    Mod+Shift+Up    { move-window-up; }
    Mod+Shift+Right { move-column-right; }

    Mod+Shift+Home  { move-column-to-first; }
    Mod+Shift+End   { move-column-to-last; }


    // ------------------------------------------------------------------------
    //  MONITORE  —  Mod + Ctrl + Richtung  (+ Shift = Fenster mitnehmen)
    // ------------------------------------------------------------------------
    Mod+Ctrl+H     { focus-monitor-left; }
    Mod+Ctrl+L     { focus-monitor-right; }
    Mod+Ctrl+Left  { focus-monitor-left; }
    Mod+Ctrl+Down  { focus-monitor-down; }
    Mod+Ctrl+Up    { focus-monitor-up; }
    Mod+Ctrl+Right { focus-monitor-right; }

    Mod+Ctrl+Shift+H     { move-column-to-monitor-left; }
    Mod+Ctrl+Shift+J     { move-column-to-monitor-down; }
    Mod+Ctrl+Shift+K     { move-column-to-monitor-up; }
    Mod+Ctrl+Shift+L     { move-column-to-monitor-right; }
    Mod+Ctrl+Shift+Left  { move-column-to-monitor-left; }
    Mod+Ctrl+Shift+Down  { move-column-to-monitor-down; }
    Mod+Ctrl+Shift+Up    { move-column-to-monitor-up; }
    Mod+Ctrl+Shift+Right { move-column-to-monitor-right; }


    // ------------------------------------------------------------------------
    //  WORKSPACES  —  U/I hoch/runter, 1–9 direkt
    //    Mod         = hinwechseln
    //    Mod+Shift   = Fenster dorthin mitnehmen
    //    Mod+Ctrl    = ganzen Workspace verschieben
    // ------------------------------------------------------------------------
    Mod+U              { focus-workspace-down; }
    Mod+I              { focus-workspace-up; }
    Mod+Page_Down      { focus-workspace-down; }
    Mod+Page_Up        { focus-workspace-up; }

    Mod+Shift+U         { move-column-to-workspace-down; }
    Mod+Shift+I         { move-column-to-workspace-up; }
    Mod+Shift+Page_Down { move-column-to-workspace-down; }
    Mod+Shift+Page_Up   { move-column-to-workspace-up; }

    Mod+Ctrl+U         { move-workspace-down; }
    Mod+Ctrl+I         { move-workspace-up; }
    Mod+Ctrl+Page_Down { move-workspace-down; }
    Mod+Ctrl+Page_Up   { move-workspace-up; }

    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }

    Mod+Shift+1 { move-column-to-workspace 1; }
    Mod+Shift+2 { move-column-to-workspace 2; }
    Mod+Shift+3 { move-column-to-workspace 3; }
    Mod+Shift+4 { move-column-to-workspace 4; }
    Mod+Shift+5 { move-column-to-workspace 5; }
    Mod+Shift+6 { move-column-to-workspace 6; }
    Mod+Shift+7 { move-column-to-workspace 7; }
    Mod+Shift+8 { move-column-to-workspace 8; }
    Mod+Shift+9 { move-column-to-workspace 9; }


    // ------------------------------------------------------------------------
    //  MAUS / SCROLLRAD
    //    Mod+Rad        = Workspaces wechseln      (Ctrl = Fenster mitnehmen)
    //    Mod+Shift+Rad  = Spalten wechseln (horizontal)
    // ------------------------------------------------------------------------
    Mod+WheelScrollDown      cooldown-ms=150 { focus-workspace-down; }
    Mod+WheelScrollUp        cooldown-ms=150 { focus-workspace-up; }
    Mod+Ctrl+WheelScrollDown cooldown-ms=150 { move-column-to-workspace-down; }
    Mod+Ctrl+WheelScrollUp   cooldown-ms=150 { move-column-to-workspace-up; }

    Mod+WheelScrollRight      { focus-column-right; }
    Mod+WheelScrollLeft       { focus-column-left; }
    Mod+Ctrl+WheelScrollRight { move-column-right; }
    Mod+Ctrl+WheelScrollLeft  { move-column-left; }

    Mod+Shift+WheelScrollDown      { focus-column-right; }
    Mod+Shift+WheelScrollUp        { focus-column-left; }
    Mod+Ctrl+Shift+WheelScrollDown { move-column-right; }
    Mod+Ctrl+Shift+WheelScrollUp   { move-column-left; }


    // ------------------------------------------------------------------------
    //  HARDWARE-TASTEN  (funktionieren auch im Sperrbildschirm)
    // ------------------------------------------------------------------------
    // Lautstärke (PipeWire/WirePlumber, max. 100 %)
    XF86AudioRaiseVolume allow-when-locked=true { spawn-sh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.1+ -l 1.0"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn-sh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.1-"; }
    XF86AudioMute        allow-when-locked=true { spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"; }
    XF86AudioMicMute     allow-when-locked=true { spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle"; }

    // Medien (playerctl, alle MPRIS-Player)
    XF86AudioPlay        allow-when-locked=true { spawn-sh "playerctl play-pause"; }
    XF86AudioStop        allow-when-locked=true { spawn-sh "playerctl stop"; }
    XF86AudioPrev        allow-when-locked=true { spawn-sh "playerctl previous"; }
    XF86AudioNext        allow-when-locked=true { spawn-sh "playerctl next"; }

    // Helligkeit
    XF86MonBrightnessUp   allow-when-locked=true { spawn "brightnessctl" "--class=backlight" "set" "+10%"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn "brightnessctl" "--class=backlight" "set" "10%-"; }
}
